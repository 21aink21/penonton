<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/layoutEpisodeBox"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_episode_card_normal"
        android:foreground="?attr/selectableItemBackground">

        <!-- Episode Number (18sp Bold) -->
        <TextView
            android:id="@+id/tvEpisodeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#E2E8F0"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="97" />

        <!-- Checkmark Status in Top-Right Corner (12x12dp) -->
        <ImageView
            android:id="@+id/ivWatchedCheckmark"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:src="@drawable/ic_checkmark_small"
            android:visibility="gone"
            app:tint="#F59E0B"
            tools:visibility="visible" />

    </FrameLayout>
</FrameLayout>
