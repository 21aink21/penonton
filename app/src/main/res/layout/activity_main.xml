<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Full-screen Dynamic Ambient Backdrop (Duplicate Layer with 30% Blur & 70% Opacity) -->
    <ImageView
        android:id="@+id/ivDynamicHomeBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.70"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Dark Gradient Dimming Scrim for Soft Ambient Glow -->
    <View
        android:id="@+id/vBackdropScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80121212" />

    <!-- Large Ambient Logo Watermark + Brand Text Lockup on Background (1dp Margin, Alpha 0.40) -->
    <LinearLayout
        android:id="@+id/layoutBackgroundWatermark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="1dp"
        android:alpha="0.40"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Watermark App Icon (Max Full Width with 1dp Margin) -->
        <ImageView
            android:id="@+id/ivBackgroundWatermark"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <!-- Watermark Brand Text Logo Selaras 100% -->
        <TextView
            android:id="@+id/tvWatermarkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.08"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8"
            android:text="ERVANIME3d"
            android:textColor="#FC6F01"
            android:textSize="40sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top App Header (Translucent & Seamless Floating Logo) -->
    <LinearLayout
        android:id="@+id/mainHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- App Logo Icon (Translucent Card with 8dp radius, no hard shadow) -->
            <androidx.cardview.widget.CardView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivHeaderAppIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvLogo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="ERVANIME3d"
                android:textColor="#FC6F01"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/mainHeader" />

    <!-- Bottom Navigation Bar (Glass Translucent allowing ambient glow) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_bottom_nav_glass"
        app:elevation="0dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemRippleColor="@color/primary_variant"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
