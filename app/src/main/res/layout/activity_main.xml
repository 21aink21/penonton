<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Top-to-Search Dynamic Ambient Backdrop (Duplicate Layer with 30% Blur & 70% Opacity fading to Search Box) -->
    <com.penonton.ui.widget.FadingImageView
        android:id="@+id/ivDynamicHomeBackdrop"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:alpha="0.70"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Large Ambient Logo Watermark + Brand Text Lockup on Background (1dp Margin, Alpha 0.40) -->
    <LinearLayout
        android:id="@+id/layoutBackgroundWatermark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="1dp"
        android:alpha="0.40"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Watermark App Icon (Max Full Width with 1dp Margin) -->
        <ImageView
            android:id="@+id/ivBackgroundWatermark"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_app_logo" />

        <!-- Watermark Brand Text Logo Selaras 100% -->
        <TextView
            android:id="@+id/tvWatermarkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.08"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8"
            android:text="PENONTON"
            android:textColor="#FB9E0C"
            android:textSize="36sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top App Header (Translucent & Seamless Floating Logo) -->
    <!-- Top App Header (Translucent & Seamless Floating Logo with Auto-Hide Floating Search) -->
    <FrameLayout
        android:id="@+id/mainHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 1. Normal Brand Header Bar (When Search is Auto-Hidden) -->
        <LinearLayout
            android:id="@+id/layoutBrandHeader"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- App Logo Icon (Seamless Floating Logo without background/border) -->
            <ImageView
                android:id="@+id/ivHeaderAppIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_app_logo" />

            <TextView
                android:id="@+id/tvLogo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="PENONTON"
                android:textColor="#FB9E0C"
                android:textSize="23sp"
                android:textStyle="bold" />

            <!-- Floating Search Icon Button (On Right of Header) -->
            <ImageView
                android:id="@+id/btnHeaderSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cari Film &amp; Series"
                android:padding="6dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_primary" />

            <!-- Bubble Size Slider Setting Button -->
            <ImageView
                android:id="@+id/btnBubbleSize"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ukuran Bubble Navigation"
                android:padding="6dp"
                android:src="@drawable/ic_tune"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- 2. Expandable Floating Search Bar (When Search is Active) -->
        <LinearLayout
            android:id="@+id/layoutHeaderSearchBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_floating"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:visibility="gone">

            <!-- Search Icon (Inside Search Bar) -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_search"
                app:tint="#94A3B8" />

            <!-- Search EditText -->
            <EditText
                android:id="@+id/etHeaderSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Cari film, serial drama, anime..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textColorHint="#8094A3B8"
                android:textSize="14sp" />

            <!-- Clear Text Button -->
            <ImageView
                android:id="@+id/btnClearHeaderSearch"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Hapus Pencarian"
                android:padding="6dp"
                android:src="@drawable/ic_clear"
                android:visibility="gone"
                app:tint="#94A3B8" />

            <!-- Close / Auto-Hide Button (Back to Search Icon) -->
            <ImageView
                android:id="@+id/btnCloseHeaderSearch"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tutup Pencarian"
                android:padding="5dp"
                android:src="@drawable/ic_clear"
                app:tint="@color/primary" />
        </LinearLayout>
    </FrameLayout>

    <!-- Fragment Container (Scrolls Edge-to-Edge Behind Bottom Nav) -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mainHeader" />

    <!-- Modern Floating Bottom Navigation Bar (No Border, Rounded Pill, Frosted Glass) -->
    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Frosted Glass Layer (Borderless Rounded Pill Glass Body) -->
        <View
            android:id="@+id/vBottomNavGlassBlur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bottom_nav_glass"
            android:clipToOutline="true" />

        <!-- Bubble Navigation Indicator Pill (BubbleNavigation) -->
        <View
            android:id="@+id/vNavBubbleIndicator"
            android:layout_width="60dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_nav_bubble_pill" />

        <!-- Crisp Bottom Navigation Bar Overlay -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@null"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:itemRippleColor="@android:color/transparent"
            app:labelVisibilityMode="selected"
            app:menu="@menu/bottom_nav_menu" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
