<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <!-- Poster image - full bleed -->
        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_variant"
            android:scaleType="centerCrop" />

        <!-- Bottom gradient overlay for text -->
        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_poster_bottom" />

        <!-- Top Left Badges (Rating & Year) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="7dp"
            android:orientation="vertical">

            <!-- Rating badge — top left (Enlarged Gold Accent) -->
            <LinearLayout
                android:id="@+id/layoutRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_gold_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/accent_gold" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textColor="@color/accent_gold"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="9.5" />
            </LinearLayout>

            <!-- Year badge — below rating (Neon Cyan/Blue Glass Accent) -->
            <TextView
                android:id="@+id/tvYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_year"
                android:textColor="#58A6FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2026"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Top Right Badges (Episode & Country) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="7dp"
            android:gravity="end"
            android:orientation="vertical">

            <!-- Episode badge — top right (Enlarged Gold Accent) -->
            <TextView
                android:id="@+id/tvLatestEp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_gold_dark"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="EP97" />

            <!-- Country badge — below episode (Cyber Glass Badge) -->
            <TextView
                android:id="@+id/tvCountry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_country"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="🇺🇸 US"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Title text overlaid at bottom -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Tales of Herding Gods" />

    </FrameLayout>

</androidx.cardview.widget.CardView>
