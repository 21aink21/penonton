<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <!-- Poster -->
        <ImageView
            android:id="@+id/ivCwPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_variant"
            android:scaleType="centerCrop" />

        <!-- Bottom gradient -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_poster_bottom" />

        <!-- Play icon center -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:alpha="0.85"
            android:src="@drawable/ic_play"
            app:tint="@color/text_primary" />

        <!-- Episode badge top-right (Enlarged Gold Accent) -->
        <TextView
            android:id="@+id/tvCwEpisode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_badge_gold_dark"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="EP 97" />

        <!-- Gold Accent Progress Bar (Enlarged 6dp) -->
        <ProgressBar
            android:id="@+id/pbCwProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="36dp"
            android:max="100"
            android:progressBackgroundTint="#4DF59E0B"
            android:progressTint="@color/accent_gold" />

        <!-- Title bottom -->
        <TextView
            android:id="@+id/tvCwTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingBottom="18dp"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Soul Land 2" />

        <!-- Position label bottom-most -->
        <TextView
            android:id="@+id/tvCwPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:textColor="@color/crimsonnoir_light"
            android:textSize="9sp"
            tools:text="Dilanjutkan dari 12:34" />
    </FrameLayout>

</androidx.cardview.widget.CardView>
